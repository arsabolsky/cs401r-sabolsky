<?xml version="1.0" ?><mxfile host="app.diagrams.net" agent="cs401r-lab2" type="device"><diagram name="NorthStar Lab 2 Data Lineage" id="lab2-lineage"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="NorthStar Retail AI Platform — Lab 2 Data Lineage" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1100" height="30" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Source to Feature Store. Edge labels: &lt;b&gt;data format&lt;/b&gt; on every edge; &lt;i&gt;write: &amp;lt;IAM principal&amp;gt;&lt;/i&gt; on every write. Grain changes from one row per transaction to one row per customer at the feature engineering job (T = 2026-04-01)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontStyle=2;fontColor=#879196;" vertex="1" parent="1"><mxGeometry x="60" y="52" width="1700" height="22" as="geometry"/></mxCell>
<mxCell id="cloud" value="AWS Cloud  ·  Region us-east-1  ·  bucket northstar-dev-data-{account-id}" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;grStroke=1;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=36;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="230" y="100" width="2170" height="600" as="geometry"/></mxCell>
<mxCell id="subnetnote" value="Both Glue ETL jobs run in northstar-dev-private-1 via the NETWORK connection northstar-dev-vpc-connection (egress through northstar-dev-nat). Every write inside AWS is performed by the northstar-dev-DataEngineer role." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;fontStyle=2;fontColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="260" y="640" width="1300" height="20" as="geometry"/></mxCell>
